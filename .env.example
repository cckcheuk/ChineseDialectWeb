# Tencent Cloud ASR (Real-time Speech Recognition v2)
# Enable ASR in console, then get these from CAM: console.tencentcloud.com/cam/capi
TENCENT_APPID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# Engine model: leave empty for per-dialect defaults (Cantonese=16k_yue, Mandarin=16k_zh;
# Hakka/Teochew/Hokkien=16k_zh_en_2.0, requires "Large Model 2.0" enabled).
# To force one engine for all dialects (e.g. 16k_zh_en_2.0 for dialect detection), set:
# TENCENT_ENGINE=
# Temporary hotwords to improve dialect accuracy (max 128, format: "word|weight,word|weight")
# TENCENT_HOTWORDS=
# TTS region (default: ap-hongkong). TTS reuses TENCENT_SECRET_ID / TENCENT_SECRET_KEY.
# TENCENT_TTS_REGION=ap-hongkong
# ASR host (default: global asr.cloud.tencent.com). No regional ASR host exists; rarely change.
# TENCENT_ASR_HOST=asr.cloud.tencent.com
# Backend port
PORT=3001